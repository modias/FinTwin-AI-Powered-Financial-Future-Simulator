# Copy to .env.local and adjust as needed. Every value here is safe to commit:
# only NEXT_PUBLIC_* variables belong in this file, and NEXT_PUBLIC_* variables
# are embedded in the browser bundle. Never put an API key or secret in here.

# Where the app reads financial data from.
#   mock  the typed dataset in src/data (the only supported mode in Phase 1)
#   api   the FastAPI backend, which arrives in a later phase
NEXT_PUBLIC_DATA_MODE=mock

# Public URL of the local FastAPI backend. The Nessie API key does not belong
# here — it lives only in backend/.env, which is not shipped to the browser.
# The dashboard still uses mock/profile data while DATA_MODE=mock. This URL is
# only for the development sandbox panel.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Anchor date for the whole demonstration dataset, as YYYY-MM-DD.
# Transactions sit before it, forecasts and upcoming events run forward from it.
# Set this to move the demo forward in time without editing the dataset.
NEXT_PUBLIC_DEMO_REFERENCE_DATE=2026-10-12
