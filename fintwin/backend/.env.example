# Copy to backend/.env and replace the placeholder. Never commit backend/.env.
# The Nessie key stays on the server. Do not put it in a NEXT_PUBLIC_ variable.
NESSIE_API_KEY=replace_with_your_api_key
NESSIE_BASE_URL=https://api.nessieisreal.com
# Seconds to wait for each Nessie request.
NESSIE_TIMEOUT_SECONDS=10

# Google Gemini. Used only by POST /api/ai/explain-risk.
# The key stays in this file. Never put it in a NEXT_PUBLIC_ variable.
GEMINI_API_KEY=replace_with_your_gemini_api_key
# Optional. Defaults to gemini-3.1-flash-lite.
# GEMINI_MODEL=gemini-3.1-flash-lite
